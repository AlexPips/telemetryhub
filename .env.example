# TelemetryHub - Environment Variables
# Copy this file to .env and fill in the values

# === Database ===
# PostgreSQL/TimescaleDB connection string
DATABASE_URL=postgres://telemetryhub:password@db:5432/telemetryhub?sslmode=disable

# Connection pool settings
DB_MIN_CONNS=2
DB_MAX_CONNS=10

# === MQTT Broker ===
# Single-broker config (used when MQTT_BROKERS is unset). Broker hostname or
# IP without protocol prefix; the scheme is added automatically from MQTT_TLS.
MQTT_BROKER=broker.example.com
MQTT_PORT=8883
MQTT_TOPIC=#
MQTT_USERNAME=telemetryhub
MQTT_PASSWORD=your_mqtt_password_here
MQTT_QOS=1
MQTT_CLIENT_ID=telemetryhub-worker-1
MQTT_TLS=true
MQTT_TLS_INSECURE=false

# Multi-broker JSON config. When set, OVERRIDES the single-broker fields above.
# Each entry: name, broker, port, topic, qos, tls, insecure, username, password, client_id.
# Example with two brokers:
# MQTT_BROKERS=[{"name":"coreic","broker":"mqtt.coreic.eu","port":8883,"topic":"CARDIMED/EBOS/DEMO_9/#","tls":true,"username":"ebos","password":"secret"},{"name":"local","broker":"mosquitto","port":1883,"topic":"sensors/#","tls":false,"username":"","password":"localpass"}]
MQTT_BROKERS=

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8080

# === Frontend ===
# URL of the Next.js frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# === Authentication ===
# JWT signing secret (MUST be at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-to-at-least-32-chars!
SESSION_EXPIRY_HOURS=24

# === Admin User ===
# Auto-created on first startup
ADMIN_EMAIL=admin@telemetryhub.local
ADMIN_PASSWORD=change_me_on_first_run!

# === Rate Limiting ===
RATE_LIMIT_PER_SEC=20

# === Logging ===
LOG_LEVEL=info
